# Frontend/Vite environment variables

# URL for the resume link
VITE_RESUME_URL=your_resume_url_here

# URL for the backend chatbot API
VITE_BOT_URL=http://localhost:8000/api/chat # Or your deployed backend URL 

# URL for the backend projects API
VITE_PROJECTS_URL=http://localhost:8000/api/projects

# Base URL for gallery API requests
VITE_API_BASE_URL=http://localhost:8000
